{
  "expo": {
    "name": "shared-achievement",
    "slug": "shared-achievement",
    "version": "1.0.19",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shared-achievement",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "updates": {
      "fallbackToCacheTimeout": 0,
      "url": "https://u.expo.dev/b97ed554-6391-44ca-86f8-c171d7f1dc50"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "at.ac.lbg.dhp.shared-achievement"
    },
    "android": {
      "permissions": [
        "android.permission.health.READ_STEPS"
      ],
      "package": "at.ac.lbg.dhp.shared_achievement",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./androidManifestPlugin.js",
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 34,
            "targetSdkVersion": 34,
            "buildToolsVersion": "34.0.0",
            "minSdkVersion": 26
          }
        }
      ],
      "react-native-health",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#ffffff",
          "mode": "production"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b97ed554-6391-44ca-86f8-c171d7f1dc50"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}